	local toastToken = 0
	local toastTweens = {}
	notify = function(msg)
		toastToken += 1
		local mine = toastToken
		for _, tw in toastTweens do
			tw:Cancel()
		end
		table.clear(toastTweens)
		toastLbl.Text = msg
		toast.BackgroundTransparency = 0.05
		toastLbl.TextTransparency = 0
		toastStroke.Transparency = 0
		toast.Visible = true
		task.delay(2.6, function()
			if toastToken ~= mine then
				return
			end
			local info = TweenInfo.new(0.3)
			toastTweens = {
				TweenService:Create(toast, info, { BackgroundTransparency = 1 }),
				TweenService:Create(toastLbl, info, { TextTransparency = 1 }),
				TweenService:Create(toastStroke, info, { Transparency = 1 }),
			}
			for _, tw in toastTweens do
				tw:Play()
			end
			task.delay(0.32, function()
				if toastToken == mine then
					toast.Visible = false
				end
			end)
		end)
	end

