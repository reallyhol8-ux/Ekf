-- หน้าต่าง / แคปซูล ใช้ตัวสร้างเดียวกัน
-- holder = กรอบนอก (ตำแหน่ง ขอบ scale) / canvas = ตัวเฟดทั้งก้อน
local function makePanel(name, size, radius, strokeColor)
	local holder = make("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Visible = false,
	}, gui)
	local holderCorner = make("UICorner", { CornerRadius = radius }, holder)

	local stroke = make("UIStroke", {
		Color = strokeColor,
		Thickness = 2,
		Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, holder)

	local scale = make("UIScale", { Scale = 0.8 }, holder)

	local canvas = make("CanvasGroup", {
		Name = "Canvas",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = col(C.dirt),
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, holder)
	local canvasCorner = make("UICorner", { CornerRadius = radius }, canvas)

	local p = {
		holder = holder,
		canvas = canvas,
		stroke = stroke,
		scale = scale,
		size = size,
		token = 0,
		corners = { holderCorner, canvasCorner },
	}

	function p:center()
		return uiPos + self.size / 2
	end

	function p:target()
		local c = self:center()
		return UDim2.fromOffset(c.X, c.Y)
	end

	function p:place()
		self.holder.Position = self:target()
	end

	-- from = จุดที่ให้เด้งออกมา (ไม่ใส่ก็ได้)
	function p:show(from)
		self.token += 1
		local h = self.holder

		if not h.Visible then
			self.canvas.GroupTransparency = 1
			self.stroke.Transparency = 1
			self.scale.Scale = from and 0.3 or 0.8
			if from then
				h.Position = UDim2.fromOffset(from.X, from.Y)
			else
				self:place()
			end
			h.Visible = true
		end

		TweenService:Create(self.scale, tPop, { Scale = 1 }):Play()
		TweenService:Create(h, tMove, { Position = self:target() }):Play()
		TweenService:Create(self.canvas, tFade, { GroupTransparency = 0 }):Play()
		TweenService:Create(self.stroke, tFade, { Transparency = 0 }):Play()
	end

	-- to = จุดที่ให้หดเข้าไป (ไม่ใส่ก็ได้)
	function p:hide(to)
		self.token += 1
		local mine = self.token
		local h = self.holder

		TweenService:Create(self.scale, tOut, { Scale = to and 0.3 or 0.85 }):Play()
		TweenService:Create(self.canvas, tOut, { GroupTransparency = 1 }):Play()
		TweenService:Create(self.stroke, tOut, { Transparency = 1 }):Play()

		local goal = to and UDim2.fromOffset(to.X, to.Y) or self:target()
		local mv = TweenService:Create(h, tOut, { Position = goal })
		mv.Completed:Connect(function()
			if self.token == mine then
				h.Visible = false
			end
		end)
		mv:Play()
	end

	return p
end

