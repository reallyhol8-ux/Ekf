	-- ===== 6) หายตัว (พาตัวเองไปไกลมาก ๆ แต่กล้องยังอยู่ในแมพ) =====
	-- ตัวจริงถูกล็อกไว้ไกลสุดขอบฟ้า คนอื่นเลยไม่เห็น / กล้องตามจุดล่องหน ขยับด้วยจอย/WASD + ปุ่ม UP DN
	local invis = newFeat("invis", {})
	local FAR = Vector3.new(0, 60000, 0)
	local ghost, invCon, invHome = nil, nil, nil

	local function invisClean(restore)
		if invCon then
			invCon:Disconnect()
			invCon = nil
		end
		local root = getRoot()
		if root then
			root.Anchored = false
			if restore and invHome then
				root.CFrame = invHome
			end
			root.AssemblyLinearVelocity = Vector3.zero
		end
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
		local hum = getHum()
		if hum and not (Feat.spectate ~= nil and Feat.spectate.on) then
			camera.CameraSubject = hum
		end
	end

	invis.enable = function()
		local root, hum = getRoot(), getHum()
		if not root or not hum then
			notify("ยังไม่มีตัวละคร")
			return false
		end
		invisClean(false)
		invHome = root.CFrame

		local g = make("Part", {
			Name = "TokenHubGhost",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Transparency = 1,
			Size = Vector3.one,
			CFrame = CFrame.new(invHome.Position + Vector3.new(0, 3, 0)),
		}, workspace)
		ghost = g

		root.CFrame = CFrame.new(FAR)
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true
		camera.CameraSubject = g

		invCon = RunService.Heartbeat:Connect(function(dt)
			local r = getRoot()
			if r and (r.Position - FAR).Magnitude > 20 then
				r.Anchored = true
				r.CFrame = CFrame.new(FAR)
			end
			local cf = camera.CFrame
			local mv = moveVector()
			local d = cf.LookVector * -mv.Z + cf.RightVector * mv.X + Vector3.new(0, vertInput(), 0)
			local mag = d.Magnitude
			if mag > 0.05 then
				g.CFrame = g.CFrame + d.Unit * 50 * math.min(mag, 1) * dt
			end
		end)
		return true
	end

	invis.disable = function()
		invisClean(true)
	end

	invis.respawn = function()
		invis.enable()
	end

