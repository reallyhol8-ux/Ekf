	-- ===== ตัวช่วยเปลี่ยนค่าแล้วคืนค่าเดิมได้ (หลายฟีเจอร์แตะค่าเดียวกันได้โดยไม่ตีกัน) =====
	-- ov[inst][prop] = { orig = ค่าเดิม, owners = { ชื่อฟีเจอร์ = ค่าที่ตั้ง } }
	local ov = {}

	local function ovBase(inst, prop)
		local byInst = ov[inst]
		local e = byInst and byInst[prop]
		if e then
			return e.orig
		end
		return inst[prop]
	end

	local function ovSet(owner, inst, prop, value)
		local byInst = ov[inst]
		if not byInst then
			byInst = {}
			ov[inst] = byInst
		end
		local e = byInst[prop]
		if not e then
			e = { orig = inst[prop], owners = {} }
			byInst[prop] = e
		end
		e.owners[owner] = value
		inst[prop] = value
	end

	-- ตั้งค่าแบบไม่ error (บางค่าบางเกมแก้จาก client ไม่ได้)
	local function tset(owner, inst, prop, value)
		pcall(ovSet, owner, inst, prop, value)
	end

	local function ovClear(owner)
		for inst, props in ov do
			for prop, e in props do
				if e.owners[owner] ~= nil then
					e.owners[owner] = nil
					local _, remain = next(e.owners)
					pcall(function()
						if remain ~= nil then
							inst[prop] = remain
						else
							inst[prop] = e.orig
						end
					end)
					if remain == nil then
						props[prop] = nil
					end
				end
			end
			if next(props) == nil then
				ov[inst] = nil
			end
		end
	end

	-- QualityLevel ใช้ร่วมกันหลายฟีเจอร์ นับจำนวนคนใช้ ตัวสุดท้ายปิดค่อยคืน
	local qlUsers, qlPrev = 0, nil

	local function qlAcquire()
		qlUsers += 1
		if qlUsers == 1 then
			pcall(function()
				local r = settings().Rendering
				qlPrev = r.QualityLevel
				r.QualityLevel = Enum.QualityLevel.Level01
			end)
		end
	end

	local function qlRelease()
		qlUsers = math.max(0, qlUsers - 1)
		if qlUsers == 0 and qlPrev ~= nil then
			local prev = qlPrev
			qlPrev = nil
			pcall(function()
				settings().Rendering.QualityLevel = prev
			end)
		end
	end

	-- กวาดทั้งแมพทีละก้อน (ไม่ให้เฟรมสะดุด) แล้วเรียก apply กับทุกชิ้น
	local function sweepWorld(f, apply)
		f.token = (f.token or 0) + 1
		local mine = f.token
		task.spawn(function()
			local list = workspace:GetDescendants()
			for i = 1, #list do
				if f.token ~= mine or not f.on then
					return
				end
				pcall(apply, list[i])
				if i % 250 == 0 then
					task.wait()
				end
			end
		end)
	end

	-- ของที่ทั้ง "ลดกราฟิก" และ "ดินน้ำมัน" ต้องทำเหมือนกัน
	local function isFx(d)
		return d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
			or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
	end

	local function envLow(owner)
		qlAcquire()
		tset(owner, Lighting, "GlobalShadows", false)
		local function effect(d)
			if d:IsA("BloomEffect") or d:IsA("SunRaysEffect") or d:IsA("DepthOfFieldEffect")
				or (d:IsA("BlurEffect") and d.Name ~= "TokenHubBlur") then
				tset(owner, d, "Enabled", false)
			end
		end
		for _, d in Lighting:GetChildren() do
			effect(d)
		end
		for _, d in camera:GetChildren() do
			effect(d)
		end
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			tset(owner, terrain, "Decoration", false)
			tset(owner, terrain, "WaterWaveSize", 0)
			tset(owner, terrain, "WaterWaveSpeed", 0)
			tset(owner, terrain, "WaterReflectance", 0)
		end
	end

