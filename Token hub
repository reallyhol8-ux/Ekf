			make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, idBox)

			spec.beforeToggle = function()
				f.id = idBox.Text
			end
			idBox.FocusLost:Connect(function()
				f.id = idBox.Text
				if f.on then
					setFeat(f, false)
					setFeat(f, true)
				end
			end)
			addSlider(row, cat.page, 80, f, 1, 10, "ความดัง")
		end
	end

