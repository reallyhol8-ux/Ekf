	-- สไลเดอร์ + ช่องพิมพ์ตัวเลข (ลากก็ได้ พิมพ์เองก็ได้)
	local function addSlider(row, page, y, f, min, max, labelText)
		local x0 = 10
		if labelText then
			label(row, labelText, UDim2.fromOffset(10, y), UDim2.fromOffset(44, 20), 11, MUTED, FONT_S)
			x0 = 56
		end

		local hit = make("TextButton", {
			Position = UDim2.fromOffset(x0, y),
			Size = UDim2.new(1, -(x0 + 76), 0, 20),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
		}, row)
		local track = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 8),
			BackgroundColor3 = col("#241508"),
			BorderSizePixel = 0,
		}, hit)
		make("UIStroke", { Color = EDGE, Thickness = 1, ApplyStrokeMode = BORDER }, track)
		local fillBar = make("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = col(C.yellow),
			BorderSizePixel = 0,
		}, track)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(12, 16),
			BackgroundColor3 = col("#f3e9d2"),
			BorderSizePixel = 0,
			ZIndex = 3,
		}, track)
		make("UIStroke", { Color = col("#3b2a00"), Thickness = 2, ApplyStrokeMode = BORDER }, knob)

		local box = make("TextBox", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, y - 1),
			Size = UDim2.fromOffset(56, 22),
			BackgroundColor3 = col("#241508"),
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Text = tostring(f.value),
			Font = FONT,
			TextSize = 14,
			TextColor3 = col(C.yellow),
		}, row)
		make("UIStroke", { Color = EDGE, Thickness = 2, ApplyStrokeMode = BORDER }, box)

		local function visual()
			local a = (f.value - min) / (max - min)
			fillBar.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
			box.Text = tostring(f.value)
		end

		local function set(n)
			n = math.clamp(math.floor(n + 0.5), min, max)
			f.value = n
			visual()
			if f.valueChanged then
				f.valueChanged(n)
			end
		end

		local dragging, tracked = false, nil
		local function fromX(x)
			local a = math.clamp((x - hit.AbsolutePosition.X) / math.max(1, hit.AbsoluteSize.X), 0, 1)
			set(min + a * (max - min))
		end

		hit.InputBegan:Connect(function(input)
			if blocked() or not isPress(input) then
				return
			end
			dragging = true
			tracked = input
			page.ScrollingEnabled = false
			fromX(input.Position.X)
		end)

		conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
			if not dragging then
				return
			end
			local mouse = input.UserInputType == Enum.UserInputType.MouseMovement
			local touch = input.UserInputType == Enum.UserInputType.Touch and input == tracked
			if mouse or touch then
				fromX(input.Position.X)
			end
		end)

		conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
			if dragging and released(tracked, input) then
				dragging = false
				tracked = nil
				page.ScrollingEnabled = true
			end
		end)

		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then
				set(n)
			else
				visual()
			end
		end)

		visual()
	end

