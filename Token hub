	-- ===== 16) ภาพดินน้ำมัน (ลดกราฟิกสุดทาง: พื้นผิวเรียบหมด ไม่มีลาย ไม่มีเงา) =====
	local clay = newFeat("clay", {})
	local clayAdd = nil

	local function clayApply(d)
		if d:IsA("BasePart") then
			if d:IsA("Terrain") then
				return
			end
			tset("clay", d, "Material", Enum.Material.SmoothPlastic)
			if d.Reflectance ~= 0 then
				tset("clay", d, "Reflectance", 0)
			end
			if d:IsA("MeshPart") and d.TextureID ~= "" then
				tset("clay", d, "TextureID", "")
			end
		elseif d:IsA("Decal") or d:IsA("Texture") then
			tset("clay", d, "Transparency", 1)
		elseif d:IsA("SurfaceAppearance") then
			tset("clay", d, "ColorMap", "")
			tset("clay", d, "NormalMap", "")
			tset("clay", d, "MetalnessMap", "")
			tset("clay", d, "RoughnessMap", "")
		elseif isFx(d) then
			tset("clay", d, "Enabled", false)
		end
	end

	clay.enable = function()
		envLow("clay")
		tset("clay", Lighting, "EnvironmentDiffuseScale", 0)
		tset("clay", Lighting, "EnvironmentSpecularScale", 0)
		for _, d in Lighting:GetChildren() do
			if d:IsA("Atmosphere") then
				tset("clay", d, "Density", 0)
				tset("clay", d, "Haze", 0)
			end
		end
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
		if clouds then
			tset("clay", clouds, "Enabled", false)
		end
		sweepWorld(clay, clayApply)
		clayAdd = workspace.DescendantAdded:Connect(function(d)
			pcall(clayApply, d)
		end)
	end

	clay.disable = function()
		clay.token = (clay.token or 0) + 1
		if clayAdd then
			clayAdd:Disconnect()
			clayAdd = nil
		end
		ovClear("clay")
		qlRelease()
	end

	-- ===== 17) แมพสว่าง (ระดับ 1-10) =====
	local bright = newFeat("bright", { value = 5 })

	local function brightApply()
		local lv = bright.value / 10
		local white = Color3.new(1, 1, 1)
		tset("bright", Lighting, "Brightness", ovBase(Lighting, "Brightness") + lv * 3)
		tset("bright", Lighting, "Ambient", ovBase(Lighting, "Ambient"):Lerp(white, lv))
		tset("bright", Lighting, "OutdoorAmbient", ovBase(Lighting, "OutdoorAmbient"):Lerp(white, lv))
		tset("bright", Lighting, "ExposureCompensation", ovBase(Lighting, "ExposureCompensation") + lv * 1.2)
		tset("bright", Lighting, "FogEnd", math.max(ovBase(Lighting, "FogEnd"), 100000))
		for _, a in Lighting:GetChildren() do
			if a:IsA("Atmosphere") then
				tset("bright", a, "Density", ovBase(a, "Density") * (1 - lv))
			end
		end
	end

	bright.enable = brightApply

	bright.disable = function()
		ovClear("bright")
	end

	bright.valueChanged = function()
		if bright.on then
			brightApply()
		end
	end

