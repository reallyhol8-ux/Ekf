-- ===== ADMIN: ฟีเจอร์ทั้งหมด + หน้าจอ =====
-- ทุกอย่างอยู่ในฟังก์ชันเดียว (กัน local เกิน 200 ตัวของสคริปต์หลัก)
-- ทุกฟีเจอร์เป็นสวิตช์อิสระ เปิดซ้อนกันได้
local function buildAdmin()
	local Lighting = game:GetService("Lighting")
	local SoundService = game:GetService("SoundService")
	local TeleportService = game:GetService("TeleportService")

	local Feat = {} -- Feat[key] = { on, value, enable(), disable(), respawn()?, changed(on)? }
	local notify = function(_msg) end -- UI ข้างล่างมาแทนที่

	local function newFeat(key, def)
		def.on = false
		Feat[key] = def
		return def
	end

	-- ตัวละคร
	local function getChar()
		return player.Character
	end
	local function getHum()
		local c = player.Character
		return c and c:FindFirstChildOfClass("Humanoid")
	end
	local function getRoot()
		local c = player.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end

	-- ตัวอ่านจอยสติ๊ก/WASD ของ Roblox (แบบสัมพันธ์กับกล้อง: X ขวา, Z ถอยหลัง)
	local controlsObj = false
	task.spawn(function()
		local ok, c = pcall(function()
			local ps = player:WaitForChild("PlayerScripts", 10)
			return require(ps:WaitForChild("PlayerModule", 10)):GetControls()
		end)
		if ok and c then
			controlsObj = c
		end
	end)

	local function moveVector()
		if controlsObj then
			local ok, v = pcall(function()
				return controlsObj:GetMoveVector()
			end)
			if ok and typeof(v) == "Vector3" then
				return v
			end
		end
		local hum = getHum()
		if hum then
			return camera.CFrame:VectorToObjectSpace(hum.MoveDirection)
		end
		return Vector3.zero
	end

	-- ===== ปุ่มขึ้น/ลง (บิน + หายตัว) =====
	local keyUp, keyDown = false, false
	local heldUp, heldDown = nil, nil -- InputObject ของนิ้วที่กดปุ่มอยู่

	local function vertInput()
		local up = keyUp or heldUp ~= nil
		local down = keyDown or heldDown ~= nil
		return (up and 1 or 0) - (down and 1 or 0)
	end

	local pad = make("Frame", {
		Name = "FlyPad",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(50, 108),
		BackgroundTransparency = 1,
		Visible = false,
	}, gui)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, pad)

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	local function padButton(text, order, onDown)
		local b = make("TextButton", {
			Name = "Pad" .. text,
			LayoutOrder = order,
			Size = UDim2.fromOffset(50, 50),
			BackgroundColor3 = col(C.pill),
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Text = text,
			Font = FONT,
			TextSize = 15,
			TextColor3 = col(C.yellow),
		}, pad)
		make("UIStroke", {
			Color = col(C.yellow),
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, b)
		b.InputBegan:Connect(function(input)
			if isPress(input) then
				onDown(input)
			end
		end)
	end
	padButton("UP", 1, function(input)
		heldUp = input
	end)
	padButton("DN", 2, function(input)
		heldDown = input
	end)

	local function released(held, input)
		if not held then
			return false
		end
		if input == held then
			return true
		end
		return held.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1
	end

	conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
		if released(heldUp, input) then
			heldUp = nil
		end
		if released(heldDown, input) then
			heldDown = nil
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local k = input.KeyCode
			if k == Enum.KeyCode.E or k == Enum.KeyCode.Space then
				keyUp = false
			elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.LeftShift then
				keyDown = false
			end
		end
	end)

	conns[#conns + 1] = UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then
			return
		end
		local k = input.KeyCode
		if k == Enum.KeyCode.E or k == Enum.KeyCode.Space then
			keyUp = true
		elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.LeftShift then
			keyDown = true
		end
	end)

	local function refreshPad()
		pad.Visible = (Feat.fly ~= nil and Feat.fly.on) or (Feat.invis ~= nil and Feat.invis.on)
	end

	-- เปิด/ปิดฟีเจอร์ (ถ้า enable ล้มเหลวจะย้อนกลับเอง)
	local function setFeat(f, on)
		on = on and true or false
		if f.on == on then
			return
		end
		f.on = on
		if on then
			local ok, res = pcall(f.enable)
			if not ok or res == false then
				if not ok then
					warn("[TokenHub]", res)
				end
				f.on = false
				pcall(f.disable)
			end
		else
			local ok, err = pcall(f.disable)
			if not ok then
				warn("[TokenHub]", err)
			end
		end
		if f.changed then
			f.changed(f.on)
		end
		refreshPad()
	end

	local function stopAll()
		for _, f in Feat do
			if f.on then
				setFeat(f, false)
			end
		end
	end

	-- ===== 1) บิน (ความเร็ว 1-999) =====
	local fly = newFeat("fly", { value = 60 })
	local flyCon, flyAtt, flyLV, flyAO = nil, nil, nil, nil

	local function flyClean()
		if flyCon then
			flyCon:Disconnect()
			flyCon = nil
		end
		if flyLV then
			flyLV:Destroy()
			flyLV = nil
		end
		if flyAO then
			flyAO:Destroy()
			flyAO = nil
		end
		if flyAtt then
			flyAtt:Destroy()
			flyAtt = nil
		end
		local hum = getHum()
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end
	end

	fly.enable = function()
		flyClean()
		local root, hum = getRoot(), getHum()
		if not root or not hum then
			notify("ยังไม่มีตัวละคร")
			return false
		end
		flyAtt = make("Attachment", { Name = "TokenHubFly" }, root)
		flyLV = make("LinearVelocity", {
			Name = "TokenHubFlyVel",
			Attachment0 = flyAtt,
			MaxForce = math.huge,
			VectorVelocity = Vector3.zero,
			RelativeTo = Enum.ActuatorRelativeTo.World,
		}, root)
		flyAO = make("AlignOrientation", {
			Name = "TokenHubFlyAlign",
			Mode = Enum.OrientationAlignmentMode.OneAttachment,
			Attachment0 = flyAtt,
			MaxTorque = math.huge,
			Responsiveness = 40,
		}, root)
		hum.PlatformStand = true
		hum.AutoRotate = false

		local lv, ao = flyLV, flyAO
		flyCon = RunService.Heartbeat:Connect(function()
			local r = getRoot()
			if not r or lv.Parent ~= r then
				return
			end
			local cf = camera.CFrame
			local mv = moveVector()
			local v = cf.LookVector * -mv.Z + cf.RightVector * mv.X + Vector3.new(0, vertInput(), 0)
			local mag = v.Magnitude
			if mag > 0.05 then
				lv.VectorVelocity = v.Unit * fly.value * math.min(mag, 1)
			else
				lv.VectorVelocity = Vector3.zero
			end
			local look = cf.LookVector
			if Vector3.new(look.X, 0, look.Z).Magnitude > 0.05 then
				ao.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(look.X, 0, look.Z))
			end
		end)
		return true
	end

	fly.disable = function()
		flyClean()
		local root = getRoot()
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end

	fly.respawn = function()
		fly.enable()
	end

