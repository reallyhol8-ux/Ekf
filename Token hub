-- ฝั่งเซิร์ฟเวอร์จะก๊อปตัวเองไปรันฝั่งผู้เล่นให้เอง / คนที่ไม่ใช่แอดมินจะไม่เห็น UI เลย
-- ถ้าจะใช้ทุกแมพ ให้วางไฟล์นี้ในทุกแมพ
-- ถ้าขึ้นเตือนว่าติดตั้งฝั่งผู้เล่นไม่ได้ ให้วางโค้ดเดียวกันนี้ใน LocalScript ที่ StarterPlayerScripts อีกอัน

if game:GetService("RunService"):IsServer() then
-- ===================== ฝั่งเซิร์ฟเวอร์ =====================
-- ตั้งค่าแอดมินอยู่ข้างล่างนี้ (ADMIN_USER_IDS): ใส่ UserId ของตัวเอง

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local TeleportService = game:GetService("TeleportService")
	local MemoryStoreService = game:GetService("MemoryStoreService")

	-- ===== ตั้งค่า: ใครเป็นแอดมิน =====
	local ADMIN_USER_IDS = {
		-- [123456789] = true, -- ใส่ UserId ของตัวเองตรงนี้ (เพิ่มได้หลายคน)
	}
	local OWNER_IS_ADMIN = true -- เจ้าของเกม (หรือเจ้าของกลุ่ม) เป็นแอดมินอัตโนมัติ
	local ADMIN_GROUP_ID = 0 -- ถ้าอยากให้ยศในกลุ่มเป็นแอดมิน ใส่ไอดีกลุ่ม (0 = ไม่ใช้)
	local ADMIN_MIN_RANK = 250
	local STUDIO_IS_ADMIN = true -- ตอนกด Play ใน Studio ให้ทุกคนเป็นแอดมิน (ไว้ทดสอบ)

	-- ===== เช็กแอดมิน (จำผลไว้ ไม่ต้องถาม Roblox ซ้ำ) =====
	local adminCache = {}

	local function computeAdmin(plr)
		if STUDIO_IS_ADMIN and RunService:IsStudio() then
			return true
		end
		if ADMIN_USER_IDS[plr.UserId] then
			return true
		end
		if OWNER_IS_ADMIN then
			if game.CreatorType == Enum.CreatorType.User then
				if plr.UserId == game.CreatorId then
					return true
				end
			elseif game.CreatorType == Enum.CreatorType.Group then
				local ok, rank = pcall(function()
					return plr:GetRankInGroup(game.CreatorId)
				end)
				if ok and rank == 255 then
					return true
				end
			end
		end
		if ADMIN_GROUP_ID ~= 0 then
			local ok, rank = pcall(function()
				return plr:GetRankInGroup(ADMIN_GROUP_ID)
			end)
			if ok and rank >= ADMIN_MIN_RANK then
				return true
			end
		end
		return false
	end

	local function isAdmin(plr)
		local c = adminCache[plr]
		if c == nil then
			c = computeAdmin(plr)
			adminCache[plr] = c
		end
		return c
	end

	-- ===== Remote (สร้างให้ครบก่อนค่อยวางใน ReplicatedStorage) =====
	local old = ReplicatedStorage:FindFirstChild("TokenHubRemotes")
	if old then
		old:Destroy()
	end

	local remotes = Instance.new("Folder")
	remotes.Name = "TokenHubRemotes"

	local checkFn = Instance.new("RemoteFunction")
	checkFn.Name = "Check"
	checkFn.Parent = remotes

	local actEvent = Instance.new("RemoteEvent")
	actEvent.Name = "Act"
	actEvent.Parent = remotes

	local noteEvent = Instance.new("RemoteEvent")
	noteEvent.Name = "Note"
	noteEvent.Parent = remotes

	remotes.Parent = ReplicatedStorage

	local function note(plr, text)
		noteEvent:FireClient(plr, text)
	end

	checkFn.OnServerInvoke = function(plr)
		return isAdmin(plr)
	end

	-- ===== อมตะ =====
	local god = {} -- god[player] = true

	local function applyGod(plr, on)
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		local ff = char:FindFirstChild("TokenHubGod")
		if on then
			hum.MaxHealth = math.huge
			hum.Health = math.huge
			if not ff then
				ff = Instance.new("ForceField")
				ff.Name = "TokenHubGod"
				ff.Visible = false
				ff.Parent = char
			end
		else
			if ff then
				ff:Destroy()
			end
			hum.MaxHealth = 100
			hum.Health = 100
		end
	end

	local function onCharacter(plr, char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum then
			return
		end
		if god[plr] then
			applyGod(plr, true)
		end
		-- ถ้ามีอะไรมาลดเลือด ให้เด้งกลับเต็มทันที
		hum.HealthChanged:Connect(function()
			if god[plr] and hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end)
	end

	local function watchPlayer(plr)
		plr.CharacterAdded:Connect(function(char)
			onCharacter(plr, char)
		end)
		if plr.Character then
			task.spawn(onCharacter, plr, plr.Character)
		end
	end

	for _, plr in Players:GetPlayers() do
		watchPlayer(plr)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(plr)
		god[plr] = nil
		adminCache[plr] = nil
	end)

	-- ===== ย้ายไปเซิร์ฟคนน้อย =====
	-- ทุกเซิร์ฟเขียนจำนวนคนของตัวเองลง MemoryStore ทุก 30 วิ (หมดอายุเองใน 90 วิ)
	-- ใช้ไม่ได้ใน Studio และเซิร์ฟส่วนตัว
	local registry = nil
	if game.JobId ~= "" and game.PrivateServerId == "" then
		local ok, map = pcall(function()
			return MemoryStoreService:GetSortedMap("TokenHubServers")
		end)
		if ok then
			registry = map
		end
	end

	if registry then
		task.spawn(function()
			while true do
				pcall(function()
					registry:SetAsync(game.JobId, #Players:GetPlayers(), 90)
				end)
				task.wait(30)
			end
		end)
		game:BindToClose(function()
			pcall(function()
				registry:RemoveAsync(game.JobId)
			end)
		end)
	end

	local hopBusy = {}

	local function hopLowPop(plr)
		if hopBusy[plr] then
			return
		end
		if not registry then
			note(plr, "ใช้ไม่ได้ (Studio หรือเซิร์ฟส่วนตัว)")
			return
		end
		hopBusy[plr] = true
		task.delay(6, function()
			hopBusy[plr] = nil
		end)

		local ok, items = pcall(function()
			return registry:GetRangeAsync(Enum.SortDirection.Ascending, 200)
		end)
		if not ok then
			note(plr, "อ่านรายชื่อเซิร์ฟเวอร์ไม่ได้")
			return
		end

		local best = nil
		for _, it in items do
			if it.key ~= game.JobId and type(it.value) == "number" and it.value < Players.MaxPlayers then
				if not best or it.value < best.value then
					best = it
				end
			end
		end

		if not best then
			note(plr, "ไม่เจอเซิร์ฟเวอร์อื่น")
			return
		end
		if best.value >= #Players:GetPlayers() then
			note(plr, "เซิร์ฟนี้คนน้อยสุดแล้ว")
			return
		end

		note(plr, "กำลังย้ายไปเซิร์ฟที่มี " .. best.value .. " คน")
		local ok2, err = pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, best.key, plr)
		end)
		if not ok2 then
			warn("[TokenHub] teleport failed:", err)
			note(plr, "ย้ายไม่สำเร็จ ลองใหม่อีกครั้ง")
		end
	end

	-- ===== คำสั่งจาก UI =====
	local lastAct = {}

	actEvent.OnServerEvent:Connect(function(plr, action, value)
		if not isAdmin(plr) then
			return
		end
		local now = os.clock()
		if lastAct[plr] and now - lastAct[plr] < 0.2 then
			return
		end
		lastAct[plr] = now

		if action == "god" and type(value) == "boolean" then
			if value then
				god[plr] = true
			else
				god[plr] = nil
			end
			applyGod(plr, value)
		elseif action == "hop" then
			hopLowPop(plr)
		end
	end)

	Players.PlayerRemoving:Connect(function(plr)
		lastAct[plr] = nil
		hopBusy[plr] = nil
	end)

	-- ===== ติดตั้งฝั่งผู้เล่นอัตโนมัติ =====
	-- ก๊อปสคริปต์ตัวนี้เองไปไว้ใน ReplicatedStorage แล้วตั้งให้รันฝั่งผู้เล่น (RunContext = Client)
	-- ฝั่งผู้เล่นจะรันโค้ดส่วนล่างของไฟล์นี้ (ส่วนที่อยู่หลัง return)
	do
		local ok, err = pcall(function()
			local old = ReplicatedStorage:FindFirstChild("TokenHubClient")
			if old then
				old:Destroy()
			end
			local copy = script:Clone()
			copy.Name = "TokenHubClient"
			copy.RunContext = Enum.RunContext.Client
			copy.Parent = ReplicatedStorage
		end)
		if not ok then
			warn("[TokenHub] ติดตั้งฝั่งผู้เล่นอัตโนมัติไม่ได้:", err)
			warn("[TokenHub] วิธีแก้: วางโค้ดไฟล์เดียวกันนี้ใน LocalScript ที่ StarterPlayer > StarterPlayerScripts อีกอัน")
		end
	end

	return -- จบฝั่งเซิร์ฟเวอร์ (ฝั่งผู้เล่นรันต่อจากบรรทัดนี้ลงไป)


end

