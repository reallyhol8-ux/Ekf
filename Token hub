	local refreshBadges -- ประกาศก่อน ใช้ในสวิตช์ทุกตัว

	local function buildRow(cat, spec, order)
		local f = spec.key and Feat[spec.key]
		local hasSlider = spec.slider ~= nil
		local h = 46
		if hasSlider or spec.kind == "spectate" then
			h = 78
		elseif spec.kind == "music" then
			h = 108
		end
		local row = rowFrame(cat.page, order, h)
		rowTexts(row, spec)

		if spec.kind == "action" then
			local b = pixBtn(row, spec.btn, 64, UDim2.new(1, -10, 0, 11), Vector2.new(1, 0))
			b.Activated:Connect(function()
				if blocked() then
					return
				end
				Actions[spec.act]()
			end)
			return
		end

		table.insert(cat.keys, spec.key)
		local setVisual = addToggle(row, function()
			if blocked() then
				return
			end
			if spec.beforeToggle then
				spec.beforeToggle()
			end
			setFeat(f, not f.on)
		end)
		f.changed = function(on)
			setVisual(on)
			refreshBadges()
		end

		if hasSlider then
			addSlider(row, cat.page, 52, f, spec.slider[1], spec.slider[2])
		end

		if spec.kind == "spectate" then
			local prev = pixBtn(row, "<", 28, UDim2.fromOffset(10, 48))
			local nextB = pixBtn(row, ">", 28, UDim2.fromOffset(42, 48))
			local nameLbl = label(row, "ยังไม่ได้เลือก", UDim2.fromOffset(78, 48), UDim2.new(1, -90, 0, 24), 12, INK, FONT_T)
			f.targetChanged = function(t)
				nameLbl.Text = t and (t.DisplayName .. " (@" .. t.Name .. ")") or "ไม่มีผู้เล่นคนอื่น"
			end
			prev.Activated:Connect(function()
				if not blocked() then
					f.cycle(-1)
				end
			end)
			nextB.Activated:Connect(function()
				if not blocked() then
					f.cycle(1)
				end
			end)
		end

		if spec.kind == "music" then
			local idBox = make("TextBox", {
				Position = UDim2.fromOffset(10, 46),
				Size = UDim2.new(1, -20, 0, 24),
				BackgroundColor3 = col("#241508"),
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				PlaceholderText = "ใส่ไอดีเพลง (ตัวเลข)",
				PlaceholderColor3 = col("#7d6a4a"),
				Text = "",
				Font = FONT_T,
				TextSize = 12,
				TextColor3 = col(C.yellow),
			}, row)
