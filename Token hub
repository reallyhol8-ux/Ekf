	if not blur then
		if size == 0 then
			return
		end
		blur = make("BlurEffect", { Name = "TokenHubBlur", Size = 0 }, Lighting)
	end
	local b = blur
	local tw = TweenService:Create(b, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = size })
	if size == 0 then
		tw.Completed:Connect(function(playState)
			if playState == Enum.PlaybackState.Completed and blur == b then
				b:Destroy()
				blur = nil
			end
		end)
	end
	tw:Play()
end

