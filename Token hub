	-- ===== 8) มองผู้เล่นคนอื่น =====
	local function restoreCamera()
		if invis.on and ghost then
			camera.CameraSubject = ghost
		else
			local h = getHum()
			if h then
				camera.CameraSubject = h
			end
		end
	end

	local spec = newFeat("spectate", { target = nil })
	local specCon, specLeaveCon = nil, nil

	local function specList()
		local list = {}
		for _, p in Players:GetPlayers() do
			if p ~= player then
				table.insert(list, p)
			end
		end
		table.sort(list, function(a, b)
			return a.Name:lower() < b.Name:lower()
		end)
		return list
	end

	function spec.cycle(dir)
		local list = specList()
		if #list == 0 then
			spec.target = nil
			if spec.on then
				restoreCamera()
			end
		else
			local idx = table.find(list, spec.target)
			if not idx then
				idx = dir > 0 and 0 or 1
			end
			spec.target = list[(idx - 1 + dir) % #list + 1]
		end
		if spec.targetChanged then
			spec.targetChanged(spec.target)
		end
	end

	spec.enable = function()
		if #specList() == 0 then
			notify("ไม่มีผู้เล่นคนอื่นในเซิร์ฟ")
			return false
		end
		if not spec.target or not spec.target.Parent then
			spec.cycle(1)
		end
		specCon = RunService.Heartbeat:Connect(function()
			local t = spec.target
			local h = t and t.Character and t.Character:FindFirstChildOfClass("Humanoid")
			if h and camera.CameraSubject ~= h then
				camera.CameraSubject = h
			end
		end)
		specLeaveCon = Players.PlayerRemoving:Connect(function(p)
			if p == spec.target then
				task.defer(function()
					spec.cycle(1)
				end)
			end
		end)
	end

	spec.disable = function()
		if specCon then
			specCon:Disconnect()
			specCon = nil
		end
		if specLeaveCon then
			specLeaveCon:Disconnect()
			specLeaveCon = nil
		end
		restoreCamera()
	end

	-- ===== 9) X-ray (มองทะลุกำแพง ปรับความโปร่ง 1-10) =====
	-- ใช้ LocalTransparencyModifier เปลี่ยนเฉพาะที่จอเรา ไม่กระทบคนอื่น และไม่แตะตัวคน/บอท
	local xray = newFeat("xray", { value = 6 })
