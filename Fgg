local function makeSlider(parent, label, id, min, max, def, onChange)
	local card = makeCard(parent, 58)
	make("TextLabel", {
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -70, 0, 20),
		BackgroundTransparency = 1,
		Text = label, Font = FONT, TextSize = 14, TextColor3 = col(AD.txt),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	local valLbl = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 4),
		Size = UDim2.fromOffset(56, 20),
		BackgroundTransparency = 1,
		Text = tostring(def), Font = FONT, TextSize = 13,
		TextColor3 = col(AD.accent),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, card)
	local barBg = make("Frame", {
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -20, 0, 10),
		BackgroundColor3 = col(AD.dark),
		BorderSizePixel = 0,
	}, card)
	make("UICorner", { CornerRadius = UDim.new(0, 4) }, barBg)
	local fill = make("Frame", {
		Size = UDim2.fromScale((def - min) / (max - min), 1),
		BackgroundColor3 = col(AD.accent),
		BorderSizePixel = 0,
	}, barBg)
	make("UICorner", { CornerRadius = UDim.new(0, 4) }, fill)
	local hit = make("TextButton", {
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1, Text = "",
	}, card)
	local dragging = false
	local function update(x)
		local pct = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + (max - min) * pct + 0.5)
		fill.Size = UDim2.fromScale(pct, 1)
		valLbl.Text = tostring(val)
		States[id] = val
		if onChange then onChange(val) end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(input.Position.X)
		end
	end)
	conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end)
	conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return card
end

