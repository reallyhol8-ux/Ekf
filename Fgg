-- 12/13/14. LOCK + VACUUM
local function applyLockVacuum()
	cleanup("lockVacuum")
	if not (States.lockPlayers or States.lockBots or States.vacuumPower > 1) then return end
	ActiveConns.lockVacuum = RunService.RenderStepped:Connect(function()
		local char = LP.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local targets = {}
		if States.lockPlayers then
			for _, p in Players:GetPlayers() do
				if p ~= LP and p.Character then
					local h = p.Character:FindFirstChild("HumanoidRootPart")
					if h then table.insert(targets, h) end
				end
			end
		end
		if States.lockBots then
			for _, m in workspace:GetChildren() do
				if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(m) then
					local h = m:FindFirstChild("HumanoidRootPart")
					if h then table.insert(targets, h) end
				end
			end
		end
		for _, h in targets do
			if States.lockPlayers or States.lockBots then
				hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(h.Position.X, hrp.Position.Y, h.Position.Z))
			end
			if States.vacuumPower > 1 then
				local dir = (hrp.Position - h.Position)
				if dir.Magnitude > 3 and dir.Magnitude < 200 then
					local pull = dir.Unit * (States.vacuumPower * 8)
					h.AssemblyLinearVelocity = h.AssemblyLinearVelocity + pull
				end
			end
		end
	end)
end

