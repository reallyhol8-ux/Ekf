local function draggable(handle, getSize, onClick)
	local dragging = false
	local moved = false
	local tracked = nil
	local startPoint = Vector3.zero
	local startPos = Vector2.zero
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			tracked = input
			startPoint = input.Position
			startPos = uiPos
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End and dragging and tracked == input then
					dragging = false
					tracked = nil
					if not moved and onClick then
						onClick()
					end
				end
			end)
		end
	end)
	conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		local mouse = input.UserInputType == Enum.UserInputType.MouseMovement
		local touch = input.UserInputType == Enum.UserInputType.Touch and input == tracked
		if mouse or touch then
			local d = input.Position - startPoint
			if d.Magnitude > 4 then
				moved = true
			end
			if moved then
				setPos(startPos + Vector2.new(d.X, d.Y), getSize())
			end
		end
	end)
end

